# Docker Compose reads this file if you copy it to .env. The shell setup script
# reads its settings from the environment instead (for example: FLUX_SETUP_PORT=3002 ./scripts/setup.sh).

# Host port for Docker setup/Compose. Defaults to 3001; 5173 is intentionally reserved for the web dev server.
FLUX_SETUP_PORT=3001
# Setup-created container name. Never set this to flux-web, which may be a separate live board.
FLUX_SETUP_CONTAINER_NAME=flux-local-web
# Setup-created named volume. Never set this to flux-data unless deliberately opting into that existing board.
FLUX_SETUP_VOLUME_NAME=flux-local-data
# Set to 1 only to explicitly allow setup.sh to mount the existing flux-data volume.
# FLUX_SETUP_ALLOW_LIVE_DATA=1

# Path to Flux's working directory. In Docker this must be writable by the non-root flux user.
FLUX_DIR=/app/packages/data/.flux
# Exact SQLite data-file path. Keep it inside the Docker data volume to persist board data.
FLUX_DATA=/app/packages/data/flux.sqlite
# HTTP port listened to inside the container. The setup script deliberately uses 3000 internally.
PORT=3000
# Optional server-wide write key. When set, clients must send it as a Bearer token for protected writes.
# FLUX_API_KEY=replace-with-a-long-random-secret
# Optional maximum uploaded blob size in bytes; defaults to 10485760 (10 MiB).
# FLUX_MAX_BLOB_SIZE=10485760

# Optional MCP client override: URL of the Flux server to use instead of .flux/config.json.
# FLUX_SERVER=http://localhost:3001
# Set to true to make `flux prime` operate in MCP mode by default.
# MCP_SERVER=true

# Build metadata read while building. setup.sh supplies BUILD_SHA and BUILD_TIME automatically.
# GIT_SHA=abcdef123456
# BUILD_SHA=abcdef123456
# BUILD_TIME=2026-08-27T00:00:00Z
# Optional frontend build-time API origin. Useful only for a development web build served separately from its API.
# VITE_API_URL=http://localhost:3000
# Frontend build metadata is injected by Vite from BUILD_SHA/GIT_SHA and BUILD_TIME; normally do not set these.
# VITE_BUILD_SHA=abcdef123456
# VITE_BUILD_TIME=2026-08-27T00:00:00Z

# CLI fallback location when neither FLUX_DIR nor a repository .flux directory is available.
# HOME=/home/your-user
# USERPROFILE=C:\\Users\\your-user
